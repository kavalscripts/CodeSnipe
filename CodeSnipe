local function makeStateButton(parent, enabled, consoleName, onToggle)
	parent.Active = true
	featureStates[consoleName] = enabled
	local pill = Instance.new("Frame")
	pill.Name = "State"
	pill.Size = UDim2.fromOffset(36, 19)
	pill.Position = UDim2.new(1, -42, 0.5, -9)
	pill.BackgroundColor3 = COLORS.Control
	pill.BorderSizePixel = 0
	pill.ZIndex = 3
	pill.Parent = parent
	addCorner(pill, 8)

	local dot = Instance.new("Frame")
	dot.Size = UDim2.fromOffset(13, 13)
	dot.Position = UDim2.new(0, 3, 0.5, -6)
	dot.BackgroundColor3 = COLORS.Dim
	dot.BorderSizePixel = 0
	dot.ZIndex = 4
	dot.Parent = pill
	addCorner(dot, UDim.new(1, 0))

	local button = Instance.new("TextButton")
	button.Size = UDim2.new(1, 0, 1, 0)
	button.BackgroundTransparency = 1
	button.Text = ""
	button.ZIndex = 5
	button.Parent = pill

	local function animState(on)
		TweenService:Create(pill, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {BackgroundColor3 = on and Color3.fromRGB(90, 8, 16) or COLORS.Control}):Play()
		TweenService:Create(dot, TweenInfo.new(0.18, Enum.EasingStyle.Back), {
			Position = on and UDim2.new(1, -16, 0.5, -6) or UDim2.new(0, 3, 0.5, -6),
			BackgroundColor3 = on and COLORS.Accent or COLORS.Dim
		}):Play()
	end

	local state = enabled
	animState(state)
	local lastSubToggle = 0

	local function toggleState()
		if tick() - lastSubToggle < 0.15 then return end
		lastSubToggle = tick()
		state = not state
		featureStates[consoleName] = state
		animState(state)
		if autoWriteEnabled then appendConsoleStatus(consoleName, state) end
		if onToggle then onToggle(state) end
	end

	button.Activated:Connect(toggleState)
	button.MouseButton1Click:Connect(toggleState)
	button.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			toggleState()
		end
	end)
	return button
end

