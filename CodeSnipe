local solved, asked, labelCount = 0, 0, 0
local submitting = false
local function submit()
    if submitting or not redeemTextBox then return end
    local codeText = redeemTextBox.Text
    if codeText == "" then return end
    submitting = true
    pcall(function()
        redeemTextBox.ClearTextOnFocus = false
    end)
    redeemTextBox:CaptureFocus()
    redeemTextBox.Text = codeText
    redeemTextBox.CursorPosition = #codeText + 1
    redeemTextBox:ReleaseFocus(true)
    task.wait()

    local codeRedeem = redeemTextBox.Parent
    local submitButton
    if codeRedeem then
        for _, child in ipairs(codeRedeem:GetDescendants()) do
            if child:IsA("TextButton") or child:IsA("ImageButton") then
                local buttonText = child:IsA("TextButton") and child.Text:lower() or ""
                local buttonName = child.Name:lower()
                if buttonText:find("redeem") or buttonText:find("submit") or buttonName:find("redeem") or buttonName:find("submit") then
                    submitButton = child
                    break
                end
            end
        end
    end
    if submitButton and submitButton.Activated then
        submitButton:Activate()
    end

    solved += 1
    statsLabel.Text = solved .. " solved / " .. asked .. " asked"
    labelCount = 0
    submitting = false
end

local function appendLabel(text, notification)
    if not text or text == "" then return end
    local codeText = text:match("%S") and text or nil
    if not codeText then return end
    asked += 1
    labelCount += 1
    if redeemTextBox then
        redeemTextBox.Text ..= codeText
    end
    local rows = {}
    activeRows[notification] = rows
    for word in codeText:gmatch("%S+") do
        table.insert(rows, createWordRow(word))
    end
    updateMenuCanvas()
    statsLabel.Text = solved .. " solved / " .. asked .. " asked"
    if active and autoSubmitEnabled() and labelCount >= threshold and redeemTextBox then
        submit()
    end
end

local function extractSmartCode(text)
    local lowerText = text:lower()
    local startIndex, endIndex = lowerText:find("code%s+is")
    if not startIndex then
        startIndex, endIndex = lowerText:find("use%s+code")
    end
    if not startIndex then
        startIndex, endIndex = lowerText:find("code%s*:")
    end
    if not endIndex then return nil end

    local code = text:sub(endIndex + 1):match("^%s*[:%-]?%s*([%w_%-]+)")
    return code and code ~= "" and code or nil
end

local function connectRedeemer()
    local topNotifFrame = playerGui:FindFirstChild("TopNotification") and playerGui.TopNotification:FindFirstChild("TopNotification")
    local codesFrame = playerGui:FindFirstChild("Codes") and playerGui.Codes:FindFirstChild("Codes")
    local codeRedeem = codesFrame and codesFrame:FindFirstChild("CodeRedeem")
    local textBox = codeRedeem and codeRedeem:FindFirstChild("TextBox")
    if not topNotifFrame or not textBox then return end
    local function processNotification(child)
        if not active or not child:IsA("TextLabel") then return end
        local text = child.Text
        if text == "" or processedNotificationText[child] == text then return end
        processedNotificationText[child] = text
        if smartModeEnabled() then
            local smartCode = extractSmartCode(text)
            if smartCode then appendLabel(smartCode, child) end
        else
            appendLabel(text, child)
        end
    end
    topNotifFrame.ChildAdded:Connect(function(child)
        if child:IsA("TextLabel") then
            processNotification(child)
            child:GetPropertyChangedSignal("Text"):Connect(function()
                processNotification(child)
            end)
        end
    end)
    topNotifFrame.ChildRemoved:Connect(function(child)
        processedNotificationText[child] = nil
        local rows = activeRows[child]
        if rows then
            for _, row in ipairs(rows) do
                if row.Parent then row:Destroy() end
            end
            activeRows[child] = nil
            updateMenuCanvas()
        end
    end)
    redeemTextBox = textBox
    return textBox
end

task.spawn(function()
    local textBox
    repeat
        textBox = connectRedeemer()
        if not textBox then task.wait(1) end
    until textBox
end)

