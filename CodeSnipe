-- ANNOUNCEMENT NOTIFICATION LISTENER --
local function resolveNotifyRemote()
	if _G.PhiNotifyRemote then return _G.PhiNotifyRemote end
	local Net = ReplicatedStorage:WaitForChild("Packages"):WaitForChild("Net")
	local getinfo = debug and (debug.getinfo or debug.info)
	if getgc and getinfo and getconnections then
		for _, d in ipairs(Net:GetDescendants()) do
			if d:IsA("RemoteEvent") then
				local ok, cs = pcall(getconnections, d.OnClientEvent)
				if ok then
					for _, c in ipairs(cs) do
						local f, fn = pcall(function() return c.Function end)
						if f and type(fn) == "function" then
							local i, info = pcall(getinfo, fn)
							if i and tostring(info.short_src or info.source or ""):find("NotificationController", 1, true) then
								return d
							end
						end
					end
				end
			end
		end
	end
	return nil
end

local function kavalStripRich(text)
	if type(text) ~= "string" then return tostring(text) end
	return (text:gsub("<[^>]->", ""))
end

local function kavalTokenize(text)
	local words = {}
	for word in text:gmatch("[%w_]+") do
		words[#words + 1] = word
	end
	return words
end

local kavalCollectBuffer = {}
local function onKavalAnnouncement(...)
	local text = kavalStripRich(tostring((...) or ""))
	text = text:match("^%s*(.-)%s*$") or ""
	if text == "" then return end

	if _riddleSolver and text:find("%s") then
		_riddleSeq = _riddleSeq + 1
		solveRiddle(text, _riddleSeq)
		return
	end

	if text:find("%s") then return end

	for _, word in ipairs(kavalTokenize(text)) do
		kavalCollectBuffer[#kavalCollectBuffer + 1] = word
	end

	local parts = {}
	for index = 1, math.min(#kavalCollectBuffer, KAVAL_WORD_COUNT) do
		parts[index] = kavalCollectBuffer[index]
	end
	if #kavalCollectBuffer < KAVAL_WORD_COUNT then return end
	kavalCollectBuffer = {}

	local captured = table.concat(parts)
	if captured == "" or _seen[captured] then return end
	_seen[captured] = true
	task.delay(1.25, function() _seen[captured] = nil end)
	appendToBox(captured)
end

local kavalNotifyRemote = resolveNotifyRemote()
local kavalListenConnection
if kavalNotifyRemote then
	if getgenv then
		local previous = getgenv().KavalCodeSniperNotifyConnection
		if previous then pcall(function() previous:Disconnect() end) end
	end
	kavalListenConnection = kavalNotifyRemote.OnClientEvent:Connect(function(...)
		if not _enabled then return end
		pcall(onKavalAnnouncement, ...)
	end)
	if getgenv then getgenv().KavalCodeSniperNotifyConnection = kavalListenConnection end
end

if getgenv then
	getgenv().StopAura = function()
		if kavalListenConnection then
			pcall(function() kavalListenConnection:Disconnect() end)
			kavalListenConnection = nil
		end
		if getgenv().KavalCodeSniperNotifyConnection then
			pcall(function() getgenv().KavalCodeSniperNotifyConnection:Disconnect() end)
			getgenv().KavalCodeSniperNotifyConnection = nil
		end
		if GUI then GUI:Destroy() end
	end
end
